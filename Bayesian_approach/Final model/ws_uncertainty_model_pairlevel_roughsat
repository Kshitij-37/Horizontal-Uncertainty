    fig.update_xaxes(title_text="sqrt(mu^2 + sigma^2)", row=1, col=2)
    fig.update_xaxes(title_text="sigma + |mu|", row=1, col=3)
    fig.update_yaxes(title_text="Actual |overall error|", row=1, col=1)
    fig.update_layout(
